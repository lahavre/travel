rules_version = '2';

// Security rules for the travel planner's private data (shared remarks, and
// later file metadata). Reads AND writes are restricted to an allow-list of
// Google accounts — this is the real gate, enforced on Google's servers, so it
// holds even though the site's code and Firebase config are public.
//
// These live in the repo for version control, but they only take effect once
// pasted into the Firebase console: Build -> Firestore Database -> Rules ->
// (replace all) -> Publish. Keep this file and the console in sync.
//
// To add a traveller: add their email to the list below and re-publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'chew.mun.chun@gmail.com'
           ];
    }

    // The to-do list's task + status is public to read (matching the public
    // itinerary); only the allow-list can change it.
    match /todoPublic/{trip} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Everything else is private to the allow-list — to-do remarks (which may
    // hold booking numbers) and, later, the booking-file metadata.
    match /{document=**} {
      allow read, write: if isEditor();
    }
  }
}

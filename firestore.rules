rules_version = '2';

// Security rules for the travel planner's private data — the to-do list, the
// notes on stays, flights and days, the car's running costs and the cost splits.
// Enforced on Google's servers, so they hold even though the site's code and its
// Firebase config are public.
//
// Access is managed from the site rather than from here. One document,
// config/access, holds it:
//
//   { editors: ["someone@gmail.com", …],          // may sign in and edit
//     trips:   { "2023-10-japan-tohoku": ["someone@gmail.com", …] } }  // per trip
//
// The OWNER below is the one thing that stays in the rules, and only the owner can
// change that document — otherwise anyone granted access could grant it to others,
// or remove the owner. Everything else is a matter of ticking a box on the site.
//
// These rules only take effect once pasted into the Firebase console:
// Build -> Firestore Database -> Rules -> (replace all) -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'chew.mun.chun@gmail.com';
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // On the editors list at all — enough to be shown the site's private areas.
    function isEditor() {
      return isOwner()
        || (isSignedIn() && request.auth.token.email in accessDoc().get('editors', []));
    }

    // Allowed this particular trip. `trips` maps a slug to the editors who may see
    // it; .get(slug, []) leaves a trip nobody has been added to closed rather than
    // erroring on a missing key.
    function canAccessTrip(slug) {
      return isOwner()
        || (isSignedIn()
            && request.auth.token.email in accessDoc().get('trips', {}).get(slug, []));
    }

    // Who may edit, and which trips they may see. Readable by anyone already on the
    // list (the site needs it to know which trips to offer); writable only by the
    // owner, which is what stops access from being handed around.
    match /config/access {
      allow read: if isOwner()
        || (isSignedIn() && request.auth.token.email in resource.data.get('editors', []));
      allow write: if isOwner();
    }

    // Everything a trip owns is keyed by its slug, so one rule covers them all.
    match /travellers/{slug}  { allow read, write: if canAccessTrip(slug); }
    match /todoList/{slug}    { allow read, write: if canAccessTrip(slug); }
    match /stayNotes/{slug}   { allow read, write: if canAccessTrip(slug); }
    match /carCosts/{slug}    { allow read, write: if canAccessTrip(slug); }
    match /costSplits/{slug}  { allow read, write: if canAccessTrip(slug); }

    // Activities added while travelling — the ticket bought at the gate that no
    // booking confirmation ever covered. Named for what it is rather than
    // `activities`, so it is never mistaken for the append-only trail below,
    // which these rules would otherwise let anyone overwrite.
    match /extraActivities/{slug} { allow read, write: if canAccessTrip(slug); }

    // The activity trail. Append-only on purpose: an entry may be created by
    // anyone who can change the trip, and then by nobody altered or removed —
    // not another editor, not the owner. A trail that can be quietly rewritten
    // by the person who broke something is not worth keeping.
    //
    // `create` also insists the entry names its author honestly, so one editor
    // cannot write a change into someone else's name.
    // Entries sit under the trip they describe, so access is decided by the slug
    // in the path and reading the newest first needs no hand-made index.
    match /activity/{slug}/entries/{entry} {
      allow read: if canAccessTrip(slug);
      allow create: if canAccessTrip(slug)
        && request.resource.data.who == request.auth.token.email;
      allow update, delete: if false;
    }

    // Nothing else is expected. Rules are a union — a catch-all that allowed
    // writes would quietly undo the append-only rule above — so the default is
    // to refuse, and a new collection needs its own rule here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

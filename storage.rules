rules_version = '2';

// Security rules for the files attached around the site — booking confirmations,
// tickets, rental agreements. They live under trips/<slug>/<kind>/<key>/, so access
// is decided per trip, from the same config/access document the Firestore rules
// read. Keep the OWNER below identical to the one in firestore.rules.
//
// Storage rules can read Firestore with firestore.get(), so the list is managed on
// the site rather than here — see firestore.rules for the document's shape.
//
// These rules only take effect once pasted into the Firebase console:
// Build -> Storage -> Rules -> (replace all) -> Publish. Storage needs the project
// on the Blaze plan.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'chew.mun.chun@gmail.com';
    }

    function accessDoc() {
      return firestore.get(/databases/(default)/documents/config/access).data;
    }

    function canAccessTrip(slug) {
      return isOwner()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && request.auth.token.email in accessDoc().get('trips', {}).get(slug, []));
    }

    // Everything a trip owns sits under its slug.
    match /trips/{slug}/{allPaths=**} {
      allow read, write: if canAccessTrip(slug);
    }

    // Nothing else is expected; keep it closed to all but the owner.
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
